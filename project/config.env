# config.env (Hour 9 expanded)

#######################################
# LLM/GPT 관련
#######################################
OPENAI_API_KEY="YOUR_API_KEY"
GPT_MODEL="gpt-4"
EMBEDDING_MODEL="text-embedding-ada-002"

# LLM 파라미터
TEMPERATURE=0.7
MAX_TOKENS=1500
TOP_P=1
FREQUENCY_PENALTY=0
PRESENCE_PENALTY=0

#######################################
# 업데이트 스케줄
#######################################
UPDATE_INTERVAL_HOURS=24

#######################################
# VectorStore 세팅
#######################################
VECTORSTORE_TOPK=3
EMBED_DIMENSION=768

#######################################
# OCR API (예시)
#######################################
USE_OCR=false
OCR_API_ENDPOINT="https://example.com/ocr"

#######################################
# 기타
#######################################
DEBUG_MODE=false

